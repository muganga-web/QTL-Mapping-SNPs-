View(Table.G)
# adjust Pvalues for multiple testing using FDR methods and turn pvalues into logp values
Table.G<- Table.G%>%
mutate(adj.Pvalue = p.adjust(Pr, method = "fdr"))%>%
mutate(log10p_adj = -log10(adj.Pvalue))
View(Table.G)
ggplot(Table.G, aes(x=position, y=log10p_adj, color=chromosome)) +
geom_point(size=0.6) +
geom_hline(yintercept = -log10(1e-2), color = "red", linetype = "dashed")+
facet_wrap(~chromosome, scales="free_x", nrow=1) +
theme_bw() +
theme(legend.position="none") +
labs(title = str_c("MANHATTAN plot for C1&C2 dwarfism (height/girth"),
y = "-log10(p)", x = "BP position")
# Example assuming columns are called chr and pos
manhattan_df <- Table.G %>%
filter(!is.na(chromosome), !is.na(position)) %>%          # change names if needed
arrange(chromosome, position) %>%
mutate(
chromosome = as.factor(chromosome),
logp = -log10(Pr)
)
man_plot <- ggplot(manhattan_df, aes(x = position, y = logp, color = chromosome)) +
geom_point(alpha = 0.7, size = 1.5) +
geom_hline(yintercept = -log10(0.05), linetype = "dashed", color = "red") +
facet_wrap(~chromosome, scales = "free_x", nrow = 1) +
labs(
title = "Manhattan Plot – Dwarfism (Height:Girth ratio)",
x = "Position",
y = expression(-log[10](p))
) +
theme_bw(base_size = 12) +
theme(
plot.title = element_text(face = "bold", hjust = 0.5),
legend.position = "none",
axis.text.x = element_blank(),
axis.ticks.x = element_blank()
)
print(man_plot)
ggsave("output/manhattan_HG.png", man_plot, width = 12, height = 5, dpi = 300)
